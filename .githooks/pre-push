#!/bin/sh
# 推送 main 时共用 release_guard 的历史策略。
# 启用：git config core.hooksPath .githooks

ref=$(git rev-parse --symbolic-full-name HEAD 2>/dev/null)
remote="$1"

# 只关心推到 main 的情况
if [ "$ref" != "refs/heads/main" ]; then
    exit 0
fi

python_bin="${PYTHON:-python}"
if ! command -v "$python_bin" >/dev/null 2>&1; then
    echo "[pre-push] 无法检查历史：找不到 $python_bin" >&2
    exit 1
fi
if ! "$python_bin" -X utf8 tools/release_guard.py --offline --no-collect --history-only; then
    echo "[pre-push] 历史检查失败，参见 docs/RELEASE_PROCESS.md 的历史策略。" >&2
    exit 1
fi

exit 0
